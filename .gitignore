/target
**/target
# Cross-platform build trees (e.g. a Linux container reproducing a CI failure
# against a bind-mounted checkout). These are cargo output like any other, and
# 700MB of them showing as untracked is alarming in a way it should not be.
/target-*
**/*.rs.bk
**/*.pdb
**/*.dSYM/
**/*.dSYM
.cargo/
!.cargo/config.toml
.env
.env.*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.tmp
*.log
*.bak
*.gz
data/raw/stdout/
data/raw/latency_demo_runs.jsonl
data/derived/*.csv
data/derived/*.parquet
charts/
__pycache__/
*.pyc
coverage.json
lcov.info
# Documentation build output
/site/
site/
docs-site/dist/
docs-site/node_modules/
docs-site/.astro/
.cache/
data/soak/
/crates/server/felix-storage/fuzz/target
.venv-perf

# Perf session inventories carry the bootstrap token and the addresses of a live
# cluster, so they stay out. The *results* do not, and they are the only record
# of how a published number was obtained -- a figure in the docs with its
# evidence on one laptop is a figure nobody else can check.
scripts/perf/azure/sessions/*.env
scripts/perf/azure/sessions/*.blob
scripts/perf/azure/*.env
!scripts/perf/azure/session.env.example
scripts/perf/azure/main.json
scripts/perf/azure/compare/sessions/
scripts/perf/azure/compare/*.json

# Python binding build artifacts.
# `maturin develop` compiles the extension straight into the package source so
# an editable install can find it; it is a build output, not source.
crates/sdk/felix-python/python/felix/*.so
crates/sdk/felix-python/python/felix/*.pyd
crates/sdk/felix-python/python/felix/*.dylib
__pycache__/
*.egg-info/
.pytest_cache/
.venv-python/

# TLC's checkpoints, if a run is ever started by hand without -metadir.
docs/formal/states/

# Conformance results, written by the client suites (see `task ts:conformance`).
*-conformance.json
