# The default first GCP session: the shape of the v0.6.0 Azure RF 3 cluster,
# and the A/B for the 64 KiB steady p99 regression (#2148) with every broker on
# its own disk. 22 vCPUs, 6 external IPs (limits: 30 vCPU, 8 addresses).
#
#   cp session.gcp-rf3.env.example session.env     # then fill in the <...>
#   set -a; source session.env; set +a
#   DRY_RUN=1 ./session.sh                            # prints the plan, creates nothing
#   ./session.sh && ./run-ab.sh cf8c400e3 "$AB_LABEL_B"
#   ./teardown.sh
#
# 3 brokers n2-standard-4 (4 vCPU, one 375 GB local SSD each)  = 12
# 2 generators n2-standard-4                                   = 8
# 1 control plane e2-small (shared core, counted as 2)         = 2
# total 22 vCPU

CLOUD=gcp
GCP_PROJECT=<project-id>
GCP_ZONE=us-central1-a
SESSION=gcp-rf3

# Quota: refuse to start above this many vCPUs, even before gcloud is asked.
GCP_VCPU_LIMIT=30

BROKER_COUNT=3
BROKER_VM_SIZE=n2-standard-4
BROKER_LOCAL_SSDS=1
LOADGEN_COUNT=2
LOADGEN_VM_SIZE=n2-standard-4
CONTROLPLANE_VM_SIZE=e2-small
BROKER_LISTENERS=1

# Cost cap and pricing. Every VM is deleted by GCP after MAX_RUN_HOURS.
PROVISIONING=STANDARD            # or SPOT
MAX_RUN_HOURS=8
PLACEMENT=compact

# Three brokers, replication factor 3, so a Quorum stream waits on a majority.
REPLICATION_FACTOR=3
SHARDS=12

# The two builds under test: v0.6.2 and a main commit (full 40-character SHA).
# Both are built once on the generator and installed on every broker. The
# generator is built from the second one, so both runs use the same instrument.
MAIN_SHA=<main-commit-sha>
BROKER_REFS="cf8c400e3 ${MAIN_SHA}"
LOADGEN_REF=${MAIN_SHA}
AB_LABEL_B=${MAIN_SHA}
TEARDOWN_AFTER_H=8

# The IdP the session authenticates against (see session.env.example).
IDP_TENANT_ID="<tenant-guid>"
IDP_CLIENT_ID="<felix-perf app client id>"
IDP_SCOPE="api://<felix-perf app client id>"
IDP_CLIENT_SECRET="<client secret>"
