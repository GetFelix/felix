{
  "name": "felix-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:release-notes": "node ../scripts/gen-release-notes.mjs",
    "dev": "npm run gen:release-notes && astro dev",
    "check:mermaid": "node ../scripts/check-mermaid.mjs",
    "check:diagrams": "node ../scripts/check-diagram-copies.mjs",
    "check:animations": "node ../scripts/check-diagram-animations.mjs",
    "check:evidence": "python3 ../scripts/check_doc_evidence.py",
    "build": "npm run gen:release-notes && npm run check:mermaid && npm run check:diagrams && npm run check:animations && npm run check:evidence && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/lobster-two": "^5.3.0",
    "astro": "7.4.2",
    "astro-mermaid": "2.2.0",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "jsdom": "30.1.3"
  }
}
