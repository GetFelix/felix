<Project>
  <!-- The SDK version follows the Felix release: it is read from the workspace
       Cargo.toml, or passed as -p:Version by CI and the release. -->
  <PropertyGroup Condition="'$(Version)' == ''">
    <WorkspaceCargo>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../Cargo.toml'))</WorkspaceCargo>
    <Version Condition="Exists('$(WorkspaceCargo)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(WorkspaceCargo)')), '(?m)^version = "([^"]+)"').Groups[1].Value)</Version>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Authors>Felix contributors</Authors>
    <Copyright>Felix contributors</Copyright>
    <RepositoryUrl>https://github.com/GetFelix/felix</RepositoryUrl>
  </PropertyGroup>
</Project>
