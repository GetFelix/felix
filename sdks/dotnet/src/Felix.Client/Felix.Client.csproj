<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Felix.Client</PackageId>
    <RootNamespace>Felix</RootNamespace>
    <AssemblyName>Felix.Client</AssemblyName>
    <Description>C# client for the Felix streaming broker, a binding over the Felix C ABI. The package carries the native library for Linux, macOS and Windows on x64 and arm64.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://docs.getfelix.dev/clients/csharp/</PackageProjectUrl>
    <PackageTags>felix;streaming;messaging;pubsub;durable-streams</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573;CS1591</NoWarn>
    <!-- Release builds put each rid's library at $(FelixNativeDir)/<rid>/<file>. -->
    <FelixNativeDir Condition="'$(FelixNativeDir)' == ''">$(MSBuildThisFileDirectory)../../runtimes</FelixNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Felix.Client.Tests" />
  </ItemGroup>

  <!-- Packed when present, so a plain build or a one-rid CI pack still works. The release job
       checks that all six are there. The loader finds them under runtimes/<rid>/native. -->
  <ItemGroup>
    <None Include="$(FelixNativeDir)/linux-x64/libfelix.so" Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false" Condition="Exists('$(FelixNativeDir)/linux-x64/libfelix.so')" />
    <None Include="$(FelixNativeDir)/linux-arm64/libfelix.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" Visible="false" Condition="Exists('$(FelixNativeDir)/linux-arm64/libfelix.so')" />
    <None Include="$(FelixNativeDir)/osx-x64/libfelix.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" Visible="false" Condition="Exists('$(FelixNativeDir)/osx-x64/libfelix.dylib')" />
    <None Include="$(FelixNativeDir)/osx-arm64/libfelix.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" Visible="false" Condition="Exists('$(FelixNativeDir)/osx-arm64/libfelix.dylib')" />
    <None Include="$(FelixNativeDir)/win-x64/felix.dll" Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false" Condition="Exists('$(FelixNativeDir)/win-x64/felix.dll')" />
    <None Include="$(FelixNativeDir)/win-arm64/felix.dll" Pack="true" PackagePath="runtimes/win-arm64/native/" Visible="false" Condition="Exists('$(FelixNativeDir)/win-arm64/felix.dll')" />
  </ItemGroup>
</Project>
